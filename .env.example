# Server Configuration
PORT=3001
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# ===========================================
# Finnhub API Configuration
# ===========================================
# Get your free API key at: https://finnhub.io/register
# Free tier: 60 API calls per minute
FINNHUB_API_KEY=your_finnhub_api_key_here

# Set to 'true' to use real Finnhub data instead of mock data
# When false or unset, the app uses static mock data (good for development)
USE_REAL_DATA=false

# ===========================================
# Cache Configuration (in milliseconds)
# ===========================================
# Stock quotes cache TTL (default: 30 seconds)
# CACHE_TTL_QUOTE=30000

# Company profiles cache TTL (default: 24 hours)
# CACHE_TTL_PROFILE=86400000

# Market status cache TTL (default: 5 minutes)
# CACHE_TTL_MARKET_STATUS=300000

# ===========================================
# Other API Keys (for future integration)
# ===========================================
# ALPHA_VANTAGE_API_KEY=your_api_key_here
# NEWS_API_KEY=your_api_key_here

# ===========================================
# Database (for future integration)
# ===========================================
# DATABASE_URL=postgresql://user:password@localhost:5432/stock_screener

# ===========================================
# Redis (for future job queue integration)
# ===========================================
# REDIS_URL=redis://localhost:6379

# ===========================================
# Job Processing
# ===========================================
JOB_PROCESSING_INTERVAL=60000
ANALYSIS_BATCH_SIZE=10
